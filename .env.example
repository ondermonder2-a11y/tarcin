# Yönetici hesabı (ilk kurulum ve kullanıcı adı)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD_AT_LEAST_12_CHARACTERS

# En az 32 karakterlik rastgele değer; imzalı HttpOnly admin oturumu için
ADMIN_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# AES-256-GCM için base64 biçiminde tam 32 bayt anahtar
# Üretim için: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SMTP_SETTINGS_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
SMTP_SETTINGS_FILE=.private/smtp-settings.enc

# Site içeriği veritabanı dosyası (tabldot menüsü, lezzet kataloğu, hero slider,
# müşteri yorumları, profil). Admin panelindeki her kayıt buraya yazılır;
# ana sayfa /api/content üzerinden okur.
# Geliştirmede: .private/site-content.json  |  Docker'da: /data/site-content.json
SITE_CONTENT_DB_FILE=.private/site-content.json

# SMTP değerleri admin panelinden ayarlanabilir; bu alanlar isteğe bağlı başlangıç ayarıdır.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# Node/Nitro sunucu hedefi
LOVABLE_NITRO_PRESET=node-server
# Admin panelinden yüklenen broşür/slider görsellerinin saklandığı klasör.
# Docker'da kalıcı birim içinde tut: /data/media
SITE_MEDIA_DIR=.private/media
